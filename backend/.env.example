# Database
DATABASE_URL="postgresql://inventory_user:inventory_secret_pw@localhost:5432/inventory_db?schema=public"

# Redis & BullMQ
REDIS_URL="redis://localhost:6379"

# Server
PORT=5000
NODE_ENV=development

# Automated Reorder Rules
REORDER_APPROVAL_LIMIT=5000
DEV_EXPOSE_OTP=true

# CORS
CORS_ORIGIN="http://localhost:3000"
